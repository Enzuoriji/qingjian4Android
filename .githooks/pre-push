#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# macOS 那个壳的 objc2 只在 Apple 平台能编，别的平台上全 workspace 测试跑不过
# （CI 里三个 job 各编各的，也是这么排除的）
if [[ "$(uname -s)" == "Darwin" ]]; then
  cargo test --workspace --locked
else
  cargo test --workspace --exclude qingjian-macos --locked
fi
