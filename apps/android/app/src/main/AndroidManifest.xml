<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按键震动。`performHapticFeedback` 本身不硬性要它，但别的输入法（Gboard 等）都声明，
         部分 OEM 的系统也会据此决定给不给马达，声明上不亏。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="@string/app_name">

        <service
            android:name=".QingjianImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 设置页：从键盘的工具页那个「设置」格子进来。
             `exported="false"` 是它只该由本应用拉起；**不指定 `android:process`**——
             同进程才只有一份 .so，另起进程是白烧一份内存。
             `excludeFromRecents` 免得它单独出现在最近任务里（它是输入法的一部分，不是一个应用）。 -->
        <activity
            android:name=".QingjianSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/settings_title"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

    </application>

</manifest>
