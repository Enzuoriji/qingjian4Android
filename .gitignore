/target
**/*.rs.bk
.DS_Store
*.app
.env
*.bat
/logs
/data
.playwright-mcp/

# 安卓壳：Gradle 的构建产物与本地配置
/apps/android/.gradle
/apps/android/build
/apps/android/app/build
/apps/android/local.properties

# 引擎的安卓产物，用 cargo ndk 现编（见 apps/android/app/build.gradle.kts），37 MB × 2 不进仓库
/apps/android/app/src/main/jniLibs/**/*.so
/apps/android/app/src/main/assets/dict.qj
/apps/android/app/src/main/assets/english.tsv
/apps/android/app/src/main/assets/lm.qj

# IDE 与崩溃转储
.idea
*.iml
*.stackdump

# Python 那些生成脚本互相 import 会留下字节码缓存（assets/icon/*.py）
__pycache__/
*.pyc
